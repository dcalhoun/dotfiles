{
  "permissions": {
    "defaultMode": "manual",
    "deny": [
      "Read(~/.ssh/**)",
      "Read(//**/.env)",
      "Read(*.pem)",
      "Read(*.key)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "context-a8c@automattic-claude-code-plugins": true,
    "swift-lsp@claude-plugins-official": true,
    "voiceprint@jck-claude-plugins": true,
    "github-enterprise@automattic-claude-code-plugins": true
  },
  "extraKnownMarketplaces": {
    "apps-infra-claude-plugins": {
      "source": {
        "source": "git",
        "url": "git@github.a8c.com:Automattic/apps-infra-claude-plugins.git"
      }
    }
  },
  "alwaysThinkingEnabled": false,
  "tui": "default",
  "editorMode": "vim"
}
