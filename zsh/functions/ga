# Create a worktree from a new or existing branch.
# Sourced from:
# - https://gist.github.com/dhh/18575558fc5ee10f15b6cd3e108ed844
# - https://x.com/dhh/status/2018631575337095389
ga() {
  if [[ -z "$1" ]]; then
    echo "Usage: ga <branch name> [start point, default: origin/HEAD]"
    return 1
  fi

  # Resolve the main worktree so running from a linked worktree doesn't nest names.
  local source_dir
  source_dir="$(wt-main)" || return 1

  local branch="$1"
  local start_point="${2:-origin/HEAD}"
  local worktree="$(wt-root "$source_dir")/${branch//\//-}"

  if git show-ref --verify --quiet "refs/heads/$branch"; then
    # Branch exists locally
    git worktree add "$worktree" "$branch"
  elif git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    # Branch exists on remote
    git worktree add --track -b "$branch" "$worktree" "origin/$branch"
  else
    # New branch, from trunk by default rather than the current worktree's branch
    if [[ -z "$2" ]] && ! git rev-parse --verify --quiet origin/HEAD >/dev/null; then
      echo "Warning: origin/HEAD is unset (fix with 'git remote set-head origin -a'); using HEAD"
      start_point="HEAD"
    fi
    git worktree add --no-track -b "$branch" "$worktree" "$start_point"
  fi || return 1

  cd "$worktree" || return 1
  wt-access add "$source_dir"

  # Symlink .claude/*.local.* files from source directory
  if [[ -d "${source_dir}/.claude" ]]; then
    local local_files=("${source_dir}"/.claude/*.local.*(N))
    if [[ ${#local_files[@]} -gt 0 ]]; then
      mkdir -p .claude
      for file in "${local_files[@]}"; do
        ln -sf "$file" ".claude/$(basename "$file")"
      done
    fi
  fi
}
