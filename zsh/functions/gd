# Remove worktree and branch from within active worktree directory.
# Sourced from:
# - https://gist.github.com/dhh/18575558fc5ee10f15b6cd3e108ed844
# - https://x.com/dhh/status/2018631575337095389
gd() {
  local git_dir common_dir
  git_dir="$(git rev-parse --path-format=absolute --git-dir)" || return 1
  common_dir="$(git rev-parse --path-format=absolute --git-common-dir)" || return 1

  # Protect against accidentally nuking the main worktree
  if [[ "$git_dir" == "$common_dir" ]]; then
    echo "Error: Not in a linked worktree"
    return 1
  fi

  local main_root="${common_dir:h}"
  local worktree="$(git rev-parse --show-toplevel)"
  local branch="$(git branch --show-current)"
  local expected="${main_root:t}--${branch//\//-}"

  # Branches may be switched intentionally, so warn rather than refuse
  if [[ -z "$branch" ]]; then
    echo "Warning: Detached HEAD; only the worktree will be removed"
  elif [[ "${worktree:t}" != "$expected" ]]; then
    echo "Warning: Branch '$branch' does not match worktree directory '${worktree:t}'"
  fi

  read "reply?Remove worktree '${worktree:t}'${branch:+ and branch '$branch'}? [y/N] "
  [[ "$reply" =~ ^[Yy]$ ]] || return

  cd "$main_root"
  git worktree remove "$worktree" --force
  if [[ -n "$branch" ]]; then
    git branch -D "$branch"
  fi
}
