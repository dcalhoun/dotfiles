# Switch to another worktree using fzf.
gs() {
  local rows row current selected
  local -a others

  rows="$(wt-list)" || return 1
  current="${$(git rev-parse --show-toplevel):A}"
  for row in "${(@f)rows}"; do
    [[ "${${row%%$'\t'*}:A}" != "$current" ]] && others+=("$row")
  done

  if (( ! ${#others} )); then
    echo "No other worktrees found."
    return 1
  fi

  selected=$(print -rl -- "${others[@]}" | fzf --no-multi --ansi --layout=reverse \
    --delimiter='\t' --with-nth=2.. --header="Switch to worktree" \
    --preview='git -C {1} -c color.status=always status -s; echo; git -C {1} log --color=always --oneline -5')

  if [[ -n "$selected" ]]; then
    cd "${selected%%$'\t'*}"
  fi
}
